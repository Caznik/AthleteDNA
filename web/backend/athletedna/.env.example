# Strava OAuth integration. Copy to .env and fill in real values.
# .env is gitignored and must never be committed.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback

# Auth: HS256 JWT signing secret. Must be at least 32 bytes. Generate a strong
# random value per environment, e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
