# Normalize line endings: store as LF in the repo and check out LF on every
# platform, so a Windows/WSL editor can't reintroduce CRLF noise into diffs.
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat these as binary — never convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
